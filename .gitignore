# Environment files
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# PHP / app cache and logs
*.log
/cache/
/tmp/
/storage/*.key
/storage/logs/
/storage/cache/
/storage/sessions/

# CVs are sensitive — keep gitignored. Blog images and PDFs are tracked so deploys don't wipe them.
/storage/uploads/cv/*
!/storage/uploads/cv/.gitkeep
/public/uploads/cv/*
!/public/uploads/cv/.gitkeep

# OS / editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Build artifacts
build/
dist/
*.tmp
