# Environment files
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/
/tools/website_audit/venv/
/tools/website_audit/__pycache__/

# PHP / app cache and logs
*.log
/cache/
/tmp/
/storage/*.key
/storage/logs/
/storage/cache/
/storage/sessions/

# CVs are sensitive — keep gitignored. Blog images and PDFs are tracked so deploys don't wipe them.
/storage/uploads/cv/*
!/storage/uploads/cv/.gitkeep
/public/uploads/cv/*
!/public/uploads/cv/.gitkeep

# Audit screenshots are generated per-submission, not source content.
/storage/audits/screenshots/*
!/storage/audits/screenshots/.gitkeep

# OS / editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Build artifacts
build/
dist/
*.tmp

# Python (website audit tool)
__pycache__/
*.pyc
venv/

# Website audit generated output (screenshots, reports)
/storage/audits/
