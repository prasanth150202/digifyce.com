# ── PHP upload limits (Apache + mod_php) ────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
</IfModule>
# ────────────────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonicalize host: redirect www to the apex domain — GET only (POST must never be redirected: 301 drops POST body)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{HTTP_HOST} ^www\.digifyce\.com$ [NC]
RewriteRule ^(.*)$ https://digifyce.com/$1 [R=301,L]

# Serve static files from storage/ directly — bypass all routing
RewriteRule ^storage/ - [L]

# PDF download endpoint (bypasses slug router entirely)
RewriteRule ^pdf-download/?$ pdf-download.php [L,QSA,NC]

# Redirect .php URLs to clean URLs — GET only (POST must never be redirected: 301 drops POST body)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ── Blog clean URL routes ────────────────────────────────────────────────────
# Blog list: base (query-string style, e.g. /blog_list?category=blog)
RewriteRule ^blog_list/?$ blog_list.php [L,QSA,NC]
# Blog list: category + page
RewriteRule ^blog_list/category/([^/]+)/page/([0-9]+)/?$ blog_list.php?category=$1&page=$2 [L,QSA,NC]
# Blog list: category only
RewriteRule ^blog_list/category/([^/]+)/?$ blog_list.php?category=$1 [L,QSA,NC]
# Blog list: tag + page
RewriteRule ^blog_list/tag/([^/]+)/page/([0-9]+)/?$ blog_list.php?tag=$1&page=$2 [L,QSA,NC]
# Blog list: tag only
RewriteRule ^blog_list/tag/([^/]+)/?$ blog_list.php?tag=$1 [L,QSA,NC]
# Blog list: page only
RewriteRule ^blog_list/page/([0-9]+)/?$ blog_list.php?page=$1 [L,QSA,NC]
# Individual blog post: /blog/slug → blog.php?slug=slug
RewriteRule ^blog/([^/]+)/?$ blog.php?slug=$1 [L,NC]
# Pages: /pages/slug -> pages.php?slug=slug
RewriteRule ^pages/([^/]+)/?$ pages.php?slug=$1 [L,QSA,NC]
# ────────────────────────────────────────────────────────────────────────────

# ── Public page clean URL routes ────────────────────────────────────────────
RewriteRule ^lead_generations/?$ lead_generations.php [L,QSA,NC]
RewriteRule ^leadform/?$ leadform.php [L,QSA,NC]
RewriteRule ^thankyou/?$ thankyou.php [L,QSA,NC]
RewriteRule ^about-us/?$ about-us.php [L,QSA,NC]
RewriteRule ^about-us-new/?$ about-us-new.php [L,QSA,NC]
RewriteRule ^brand-shoot/?$ brand-shoot.php [L,QSA,NC]
RewriteRule ^careers/?$ careers.php [L,QSA,NC]
RewriteRule ^content-marketing/?$ content-marketing.php [L,QSA,NC]
RewriteRule ^creative-dev/?$ creative-dev.php [L,QSA,NC]
RewriteRule ^d2c-branding/?$ d2c-branding.php [L,QSA,NC]
RewriteRule ^d2c/?$ d2c.php [L,QSA,NC]
RewriteRule ^e-com-marketing/?$ e-com-marketing.php [L,QSA,NC]
RewriteRule ^instavideos/?$ instavideos.php [L,QSA,NC]
RewriteRule ^market-manage/?$ market-manage.php [L,QSA,NC]
RewriteRule ^performance-marketing/?$ performance-marketing.php [L,QSA,NC]
RewriteRule ^products/?$ products.php [L,QSA,NC]
RewriteRule ^service/?$ service.php [L,QSA,NC]
RewriteRule ^technology/?$ technology.php [L,QSA,NC]
RewriteRule ^testimonial/?$ testimonial.php [L,QSA,NC]
# ────────────────────────────────────────────────────────────────────────────

# Slug router: handles all clean URL routing, slug redirects, and PHP file fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ slug_router.php?uri=$1 [L,QSA]
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
# NOTE: expose_php (the X-Powered-By source) is PHP_INI_SYSTEM scope and cannot
# be set from .htaccess/php_flag — that would 500 the site. Suppress it in
# php.ini (expose_php = Off) instead; Header unset below strips it in transit
# as a belt-and-suspenders measure if php.ini can't be touched.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
</IfModule>
# ────────────────────────────────────────────────────────────────────────────
